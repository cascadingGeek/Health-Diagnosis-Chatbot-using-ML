# ENVIRONMENT
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=

# PostgreSQL — asyncpg driver required
DATABASE_URL=postgresql+asyncpg://postgres......

# ML Artifacts
MODEL_VERSION=v1

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Inference — predictions below this score are labelled "uncertain"
CONFIDENCE_THRESHOLD=0.7

# App
LOG_LEVEL=INFO
DEBUG=false
